# Server-side only. Never prefix with VITE_ (that would expose it to the browser).
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Any tool-calling Nemotron model available to your key
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Used automatically if the primary model is rate-limited (429) or unavailable (404)
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
